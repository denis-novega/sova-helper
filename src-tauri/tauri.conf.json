{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Sova",
  "version": "0.1.1",
  "identifier": "app.sova.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:serve",
    "beforeBuildCommand": "npm run frontend:build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Sova",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/backend/**"
    ]
  }
}
